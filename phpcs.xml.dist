<?xml version="1.0"?>
<ruleset name="crosspost">
    <description>PSR-12 for the plugin and its tests.</description>
    <file>src</file>
    <file>tests</file>
    <file>crosspost.php</file>
    <file>uninstall.php</file>
    <file>examples</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <!-- Long escaped HTML strings read better on one line. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="420"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
    <!-- WordPress-style stubs in tests declare global functions and classes. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/phpstan-bootstrap.php</exclude-pattern>
        <exclude-pattern>crosspost.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
        <exclude-pattern>src/autoload.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/Feature/SchemaTest.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName.NotCamelCaps">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/Support/MysqliWpdb.php</exclude-pattern>
        <exclude-pattern>tests/Feature/SchemaTest.php</exclude-pattern>
    </rule>
    <rule ref="PSR2.Methods.MethodDeclaration.Underscore">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
</ruleset>
